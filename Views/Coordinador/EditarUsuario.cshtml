@model Unilife.Models.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Editar usuario";
}

<link rel="stylesheet" href="~/css/coordinador.css" asp-append-version="true" />

<div class="coordinador-page">
    <div class="coordinador-header">
        <h1>Editar usuario</h1>
        <p>Modifica los datos del usuario. La contraseña es opcional.</p>
    </div>

    <div class="admin-form-card">
        <form asp-action="EditarUsuario" asp-route-id="@ViewBag.UserId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    <option value="Alumno">Alumno</option>
                    <option value="Docente">Docente</option>
                </select>
            </div>

            <div class="mt-3">
                <label asp-for="Carrera" class="form-label"></label>
                <select asp-for="Carrera" class="form-select">
                    <option value="">— Sin carrera —</option>
                    <optgroup label="Ingenierías">
                        @foreach (var c in Unilife.Models.Carreras.Ingenierias)
                        { <option value="@c">@c</option> }
                    </optgroup>
                    <optgroup label="Ciencias Sociales">
                        @foreach (var c in Unilife.Models.Carreras.CienciasSociales)
                        { <option value="@c">@c</option> }
                    </optgroup>
                    <optgroup label="Ciencias Médicas">
                        @foreach (var c in Unilife.Models.Carreras.CienciasMedicas)
                        { <option value="@c">@c</option> }
                    </optgroup>
                </select>
            </div>

            <!-- Contraseña opcional -->
            <div class="mt-3">
                <label for="NuevaContrasena" class="form-label">
                    Nueva contraseña <span class="text-muted small">(dejar vacío para no cambiar)</span>
                </label>
                <input type="password" id="NuevaContrasena" name="NuevaContrasena"
                       class="form-control" autocomplete="new-password" />
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Usuarios" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
