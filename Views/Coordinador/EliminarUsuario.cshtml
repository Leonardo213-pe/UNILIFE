@model Unilife.Models.ApplicationUser

@{
    ViewData["Title"] = "Eliminar usuario";
}

<link rel="stylesheet" href="~/css/coordinador.css" asp-append-version="true" />

<div class="coordinador-page">
    <div class="coordinador-header">
        <h1>Eliminar usuario</h1>
    </div>

    <div class="admin-form-card">
        <p class="text-danger">¿Estás seguro de que quieres eliminar al siguiente usuario?</p>

        <dl class="row">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">@ViewBag.Rol</dd>

            <dt class="col-sm-3">Carrera</dt>
            <dd class="col-sm-9">@(Model.Carrera ?? "—")</dd>
        </dl>

        <form asp-action="EliminarUsuario" asp-route-id="@Model.Id" method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                <a asp-action="Usuarios" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
