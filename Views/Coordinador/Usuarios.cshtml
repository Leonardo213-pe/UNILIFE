@model IEnumerable<(Unilife.Models.ApplicationUser Usuario, string Rol)>

@{
    ViewData["Title"] = "Usuarios";
    string buscar    = ViewBag.Buscar    ?? "";
    string filtroRol = ViewBag.FiltroRol ?? "";
}

<link rel="stylesheet" href="~/css/coordinador.css" asp-append-version="true" />

<div class="coordinador-page">

    <div class="coordinador-header d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Usuarios</h1>
            <p>Alumnos y docentes registrados en el sistema.</p>
        </div>
        <a asp-action="CrearUsuario" class="btn btn-success">+ Nuevo usuario</a>
    </div>

    <!-- Barra de búsqueda y filtros -->
    <form method="get" asp-action="Usuarios" class="d-flex gap-2 mb-3 flex-wrap">
        <input name="buscar" value="@buscar" type="text" placeholder="Buscar por nombre o correo…"
               class="form-control" style="max-width:300px;" />

        <a asp-action="Usuarios" class="btn @(filtroRol == "" ? "btn-dark" : "btn-outline-secondary")">Todos</a>
        <a asp-action="Usuarios" asp-route-filtroRol="Alumno" asp-route-buscar="@buscar"
           class="btn @(filtroRol == "Alumno" ? "btn-dark" : "btn-outline-secondary")">Alumnos</a>
        <a asp-action="Usuarios" asp-route-filtroRol="Docente" asp-route-buscar="@buscar"
           class="btn @(filtroRol == "Docente" ? "btn-dark" : "btn-outline-secondary")">Docentes</a>

        <input type="hidden" name="filtroRol" value="@filtroRol" />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </form>

    <!-- Tabla -->
    <div class="table-responsive" style="background:white;border-radius:16px;padding:8px;box-shadow:0 4px 16px rgba(0,0,0,0.07);">
        <table class="table table-hover admin-table mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Carrera</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No se encontraron usuarios.</td>
                    </tr>
                }
                @foreach (var (usuario, rol) in Model)
                {
                    <tr>
                        <td class="fw-semibold">@usuario.Nombre @usuario.Apellido</td>
                        <td class="text-muted small">@usuario.Email</td>
                        <td>
                            <span class="badge rounded-pill @(rol == "Docente" ? "bg-primary" : "bg-secondary")">
                                @rol
                            </span>
                        </td>
                        <td class="small">@(usuario.Carrera ?? "—")</td>
                        <td>
                            <a asp-action="EditarUsuario" asp-route-id="@usuario.Id"
                               class="btn btn-sm btn-outline-primary me-1">Editar</a>
                            <a asp-action="EliminarUsuario" asp-route-id="@usuario.Id"
                               class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 d-flex justify-content-between align-items-center">
        <small class="text-muted">@Model.Count() usuario(s) encontrado(s)</small>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Volver al panel</a>
    </div>

</div>
