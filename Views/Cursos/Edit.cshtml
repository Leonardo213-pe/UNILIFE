@model Unilife.Models.CursoFormViewModel

@{
    ViewData["Title"] = "Editar curso";
    var docentes    = ViewBag.Docentes   as IList<Unilife.Models.ApplicationUser> ?? new List<Unilife.Models.ApplicationUser>();
    var alumnos     = ViewBag.Alumnos    as IList<Unilife.Models.ApplicationUser> ?? new List<Unilife.Models.ApplicationUser>();
    var carrerasDb  = ViewBag.CarrerasDb as List<Unilife.Models.CarreraRegistrada> ?? new List<Unilife.Models.CarreraRegistrada>();
    var medicas     = carrerasDb.Where(c => c.EsMedica).Select(c => c.Nombre).ToList();
}

<h1>Editar curso</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Carrera" class="form-label"></label>
        <select asp-for="Carrera" id="editCarrera" class="form-select">
            <option value="">— Selecciona una carrera —</option>
            @foreach (var g in new[] { "Ingenierías", "Ciencias Sociales", "Ciencias Médicas" })
            {
                var lista = carrerasDb.Where(c => c.Grupo == g).ToList();
                if (lista.Any())
                {
                    <optgroup label="@g">
                        @foreach (var c in lista)
                        { <option value="@c.Nombre">@c.Nombre</option> }
                    </optgroup>
                }
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Semestre" class="form-label"></label>
        <select asp-for="Semestre" id="editSemestre" class="form-select">
            <option value="">— Semestre —</option>
            <option value="I">I</option>
            <option value="II">II</option>
            <option value="III">III</option>
            <option value="IV">IV</option>
            <option value="V">V</option>
            <option value="VI">VI</option>
            <option value="VII">VII</option>
            <option value="VIII">VIII</option>
            <option value="IX">IX</option>
            <option value="X">X</option>
            <option value="XI">XI</option>
            <option value="XII">XII</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="DocenteId" class="form-label">Docente</label>
        <select asp-for="DocenteId" class="form-select">
            <option value="">— Sin asignar —</option>
            @foreach (var d in docentes)
            { <option value="@d.Id">@d.Nombre @d.Apellido</option> }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Alumnos participantes</label>
        <div class="border rounded p-3" style="max-height:200px;overflow-y:auto;">
            @foreach (var a in alumnos)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="AlumnoIds" value="@a.Id"
                           id="a_@a.Id" @(Model.AlumnoIds.Contains(a.Id) ? "checked" : "") />
                    <label class="form-check-label" for="a_@a.Id">
                        @a.Nombre @a.Apellido <span class="text-muted small">— @(a.Carrera ?? "Sin carrera")</span>
                    </label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <script>
        const carrerasMedicas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(medicas));

        function ajustarSemestres(carrera) {
            const sel = document.getElementById('editSemestre');
            const esMedica = carrerasMedicas.includes(carrera);
            Array.from(sel.options).forEach(o => {
                if (o.value === 'XI' || o.value === 'XII') o.hidden = !esMedica;
            });
            if (!esMedica && (sel.value === 'XI' || sel.value === 'XII')) sel.value = '';
        }

        document.getElementById('editCarrera').addEventListener('change', function () {
            ajustarSemestres(this.value);
        });

        ajustarSemestres(document.getElementById('editCarrera').value);
    </script>
}
