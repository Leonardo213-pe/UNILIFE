@model Unilife.Models.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
    var cultura = new System.Globalization.CultureInfo("es-ES");
    var fecha   = DateTime.Now.ToString("dddd, dd 'de' MMMM, yyyy", cultura);
    fecha = char.ToUpper(fecha[0]) + fecha.Substring(1);
    var hoy = DateTime.Today;
    var tareasUrgentes = Model.ProximasTareas
        .Where(t => t.FechaEntrega >= hoy && t.FechaEntrega <= hoy.AddDays(7))
        .OrderBy(t => t.FechaEntrega)
        .ToList();
    var diasSemana = new[] { "Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado" };
    var diaHoy = diasSemana[(int)hoy.DayOfWeek];
    var clasesHoy = Model.Horario
        .SelectMany(c => c.Horarios
            .Where(h => h.Dia == diaHoy)
            .Select(h => new { Curso = c.Nombre, Tipo = h.Tipo, HoraInicio = h.HoraInicio, HoraFin = h.HoraFin, Aula = h.CodigoAula }))
        .OrderBy(x => x.HoraInicio)
        .ToList();
}

<link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true" />

<div class="inicio-dash">

    @* ── Barra superior ─────────────────────────────────── *@
    <div class="inicio-topbar">
        <div class="inicio-saludo">
            <h1>Hola, @Model.Nombre 👋</h1>
            <p>@fecha</p>
        </div>
        <div class="usmp-pill">
            <span class="usmp-brand">🛡 UniLife</span>
            @if (Model.EsDocente)
            {
                <span class="usmp-menu">👨‍🏫 Docente</span>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════ *@
    @*  DOCENTE                                             *@
    @* ════════════════════════════════════════════════════ *@
    @if (Model.EsDocente)
    {
        <div class="stats-row stats-3">
            <div class="stat-card">
                <div class="stat-icon icon-red">📚</div>
                <div>
                    <div class="stat-number">@Model.MisCursos.Count</div>
                    <div class="stat-label">Mis cursos</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-blue">👥</div>
                <div>
                    <div class="stat-number">@Model.TotalAlumnos</div>
                    <div class="stat-label">Total alumnos</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-orange">📅</div>
                <div>
                    <div class="stat-number">@Model.EventosProximos</div>
                    <div class="stat-label">Eventos próximos</div>
                </div>
            </div>
        </div>

        @* Horario ancho *@
        <div class="dash-card dash-full">
            <div class="dash-head">
                <h3>🕒 Clases de hoy</h3>
                <span class="dia-hoy-badge">@diaHoy</span>
            </div>
            @if (clasesHoy.Any())
            {
                <div class="horario-scroll">
                    @foreach (var cl in clasesHoy)
                    {
                        <div class="horario-card @(cl.Tipo == "Práctico" ? "hc-prac" : "hc-teo")">
                            <div class="hc-hora">@cl.HoraInicio.ToString(@"hh\:mm") – @cl.HoraFin.ToString(@"hh\:mm")</div>
                            <div class="hc-nombre">@cl.Curso</div>
                            <div class="hc-meta">🏫 @cl.Aula</div>
                            <span class="hc-tipo">@cl.Tipo</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="horario-vacio">Sin clases hoy 🎉</div>
            }
        </div>

        @* Cursos + Eventos *@
        <div class="dash-grid">

            <div class="dash-card">
                <div class="dash-head">
                    <h3>📚 Mis cursos</h3>
                    <a asp-controller="Cursos" asp-action="Index" class="ver-todas">Ver todos</a>
                </div>
                <div class="cursos-scroll">
                @if (Model.MisCursos.Any())
                {
                    foreach (var c in Model.MisCursos.Take(5))
                    {
                        int alumnos = c.Participantes?.Count ?? 0;
                        <a href="@Url.Action("Details", "Cursos", new { id = c.Id })" class="curso-item">
                            <div class="ci-icon">📘</div>
                            <div class="ci-body">
                                <div class="ci-nombre">@c.Nombre</div>
                                <div class="ci-meta">@c.Carrera &middot; Sem. @c.Semestre</div>
                            </div>
                            <span class="ci-badge">@alumnos alumnos</span>
                        </a>
                    }
                }
                else
                {
                    <p class="item-sub">Aún no tienes cursos asignados.</p>
                }
                </div>
            </div>

            <div class="dash-card">
                <div class="dash-head"><h3>🔔 Próximos eventos</h3></div>
                @if (Model.Recordatorios.Any())
                {
                    <div class="eventos-scroll">
                        @foreach (var e in Model.Recordatorios)
                        {
                            <div class="item item-purple">
                                <div class="item-emoji">📅</div>
                                <div>
                                    <div class="item-title">@e.Titulo</div>
                                    <div class="item-sub">@e.Fecha.ToString("dd MMM", cultura) · @e.Lugar</div>
                                </div>
                                <span class="badge-pill badge-event">@e.TipoEvento</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="item-sub">No hay eventos próximos.</p>
                }
            </div>

        </div>
    }

    @* ════════════════════════════════════════════════════ *@
    @*  ALUMNO                                              *@
    @* ════════════════════════════════════════════════════ *@
    else
    {
        <div class="stats-row stats-3">
            <div class="stat-card">
                <div class="stat-icon icon-red">📌</div>
                <div>
                    <div class="stat-number">@Model.Pendientes</div>
                    <div class="stat-label">Tareas pendientes</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-green">✓</div>
                <div>
                    <div class="stat-number">@Model.Completadas</div>
                    <div class="stat-label">Completadas</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-orange">📅</div>
                <div>
                    <div class="stat-number">@Model.EventosProximos</div>
                    <div class="stat-label">Eventos próximos</div>
                </div>
            </div>
        </div>

        @* Horario ancho *@
        <div class="dash-card dash-full">
            <div class="dash-head">
                <h3>📖 Clases de hoy</h3>
                <span class="dia-hoy-badge">@diaHoy</span>
            </div>
            @if (clasesHoy.Any())
            {
                <div class="horario-scroll">
                    @foreach (var cl in clasesHoy)
                    {
                        <div class="horario-card @(cl.Tipo == "Práctico" ? "hc-prac" : "hc-teo")">
                            <div class="hc-hora">@cl.HoraInicio.ToString(@"hh\:mm") – @cl.HoraFin.ToString(@"hh\:mm")</div>
                            <div class="hc-nombre">@cl.Curso</div>
                            <div class="hc-meta">🏫 @cl.Aula</div>
                            <span class="hc-tipo">@cl.Tipo</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="horario-vacio">Sin clases hoy 🎉</div>
            }
        </div>

        @* Mis cursos + Eventos *@
        <div class="dash-grid">

            <div class="dash-card">
                <div class="dash-head">
                    <h3>📚 Mis cursos</h3>
                    <a asp-controller="Cursos" asp-action="Index" class="ver-todas">Ver todos</a>
                </div>
                <div class="cursos-scroll">
                @if (Model.MisCursos.Any())
                {
                    foreach (var c in Model.MisCursos.Take(6))
                    {
                        <a href="@Url.Action("Details", "Cursos", new { id = c.Id })" class="curso-item">
                            <div class="ci-icon">📘</div>
                            <div class="ci-body">
                                <div class="ci-nombre">@c.Nombre</div>
                                <div class="ci-meta">
                                    @c.Carrera &middot; Sem. @c.Semestre
                                    @if (c.DocenteUser != null)
                                    {
                                        <span> &middot; @c.DocenteUser.Nombre @c.DocenteUser.Apellido</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="empty-state-mini">
                        <span>📭</span>
                        <p>No estás inscrito en ningún curso aún.</p>
                    </div>
                }
                </div>
            </div>

            <div class="dash-card">
                <div class="dash-head"><h3>🔔 Próximos eventos</h3></div>
                @if (Model.Recordatorios.Any())
                {
                    <div class="eventos-scroll">
                        @foreach (var e in Model.Recordatorios)
                        {
                            <div class="item item-blue">
                                <div class="item-emoji">📅</div>
                                <div>
                                    <div class="item-title">@e.Titulo</div>
                                    <div class="item-sub">@e.Fecha.ToString("dd MMM", cultura) · @e.Lugar</div>
                                </div>
                                <span class="badge-pill badge-event">@e.TipoEvento</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="item-sub">No hay eventos próximos.</p>
                }
            </div>

        </div>
    }

</div>
